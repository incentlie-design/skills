    "color_script_ref": {"type": "ref", "meaning": "color-script 产物"},
    "style_frame_ref": {"type": "ref", "meaning": "style-frame-lock 产物"},
    "audio_probe_ref": {"type": "ref", "meaning": "audio-probe-report"},
    "edit_decision_ref": {"type": "ref", "meaning": "edit-decision-notes"},
    "limited_animation_ref": {"type": "ref", "meaning": "limited-animation-plan"},
    "i2v_plan_ref": {"type": "ref", "meaning": "image-to-video-plan"},
    "animatic_ref": {"type": "ref", "meaning": "animatic-plan 或实测 animatic bytes"},
    "loop_background_ref": {"type": "ref", "meaning": "looping-background-plan"},
