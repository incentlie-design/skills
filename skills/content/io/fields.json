{
  "schema_version": 1,
  "ref_shape": {
    "id": "string; stable slug or proposed:<slug>",
    "kind": "string; entity or artifact_kind",
    "revision": "positive integer or unknown or provisional; never latest",
    "uri": "optional path or URL",
    "sha256": "optional lowercase hex of exact bytes"
  },
  "enums": {
    "status": ["pass", "revise", "blocked"],
    "maturity": ["provisional", "design-ready"],
    "rights_status": ["allowed", "unresolved", "denied"],
    "role": ["story_director", "visual_director", "audio_director", "editor", "validator", "producer"],
    "r_alignment": ["R1", "R2", "R3", "R4", "R5", "R6"],
    "media_form": ["audio_only", "stills_plus_audio", "audiovisual"],
    "license_class": ["licensed-library", "cc-with-attribution", "original-commission", "generated-research-only"],
    "fact_class": ["from_source", "adaptation_choice", "inference"]
  },
  "fields": {
    "source_ref": {"type": "ref", "meaning": "不可变源小说身份"},
