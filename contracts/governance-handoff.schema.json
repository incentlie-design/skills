{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance-handoff.schema.json",
  "title": "Engineering governance handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "slices"],
  "properties": {
    "schema_version": {"const": 2},
    "handoff_id": {"type": "string", "minLength": 1},
    "slices": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project"},
        "workspace": {"$ref": "#/$defs/workspace"},
        "repo": {"$ref": "#/$defs/repo"},
        "agent": {"$ref": "#/$defs/agent"}
      }
    }
  },
  "x-slice-owners": {
    "project": "eng-project-governance",
    "workspace": "eng-workspace-governance",
    "repo": "eng-repo-governance",
    "agent": "eng-agent-governance"
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_ref"],
      "properties": {
        "decision_ref": {"type": "string", "minLength": 1},
        "work_item_ref": {"type": "string", "minLength": 1},
        "goal_revision": {"type": "string", "minLength": 1},
        "architecture_revision": {"type": "string", "minLength": 1},
        "task_revision": {"type": "string", "minLength": 1},
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "release_target": {"type": "string", "minLength": 1},
        "remote_sync_plan_ref": {"type": "string", "minLength": 1}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_ref", "repo_refs", "dependency_edges"],
      "properties": {
        "manifest_ref": {"type": "string", "minLength": 1},
        "repo_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/repo_ref"}
        },
        "dependency_edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependency_edge"}
        }
      }
    },
    "repo_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "path", "remote", "role", "default_ref", "commit"],
      "properties": {
        "repo_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "remote": {"type": ["string", "null"]},
        "role": {"type": "string", "minLength": 1},
        "default_ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1}
      }
    },
    "dependency_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "base_commit", "head_commit", "write_scope"],
      "properties": {
        "repo_id": {"type": "string", "minLength": 1},
        "base_commit": {"type": "string", "minLength": 1},
        "head_commit": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "write_scope": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "freeze_evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "promotion_evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "scope"],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "assignment_ref": {"type": "string", "minLength": 1},
        "work_item_ref": {"type": "string", "minLength": 1},
        "output_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "role": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "limit"],
          "properties": {
            "unit": {"type": "string", "minLength": 1},
            "limit": {"type": "number", "minimum": 0},
            "consumed": {"type": "number", "minimum": 0}
          }
        },
        "status": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1},
        "handoff_ref": {"type": "string", "minLength": 1},
        "released_leases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
